import math

# 基本的な設定
total_particles_in_japanese = 45
chosen_particles = 7
particles_in_proposition = 8

total_combinations = math.comb(total_particles_in_japanese, chosen_particles)
matching_combinations = math.comb(particles_in_proposition, chosen_particles)
p_particles = matching_combinations / total_combinations

# 時間の近接（11時間16分 ≒ 676分）
# 1年（525600分）の中で、ある特定の投稿の直後676分以内にピンポイントで投稿が重なる確率
# あるいは1日（1440分）の中でこの時間帯に合致する確率を簡易的に1/2とする
p_time = 676 / 525600 

# 同じプラットフォームで、特定のアカウント群が相互に観測可能な位置にいる確率（簡易的に1/100とする）
p_platform = 0.01

# 統合確率の計算
total_probability = p_particles * p_time * p_platform
print(f"P_particles: {p_particles:.10f}")
print(f"P_time (proximity): {p_time:.10f}")
print(f"Total Combined Probability: {total_probability:.15f}")
