## 4. 統計的判定および執行コマンド（Statistical Verification & Enforcements）

def calculate_cumulative_anomaly(parity_scores):
    """
    ポアソン分布および累積二項確率に基づき、5軸すべてが偶然同期する累積確率を算出
    """
    combined_probability = 1.0
    for axis, score in parity_scores.items():
        # スコアを個別確率空間に射射（10点に近いほど偶然確率は低確率化）
        p_axis = mapping_score_to_probability(score)
        combined_probability *= p_axis
        
    return combined_probability
