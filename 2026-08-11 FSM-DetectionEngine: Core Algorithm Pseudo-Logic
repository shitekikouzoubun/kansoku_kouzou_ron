## 2. メイン検出パイプライン（Main Detection Pipeline）

def execute_fsm_audit(text_seed, text_residue):
    """
    入力されたSEEDとRESIDUEの位相構造を監査し、不法依拠性を検証するメイン関数
    """
    result = FSMResult()
    
    # ステップ1: テキストのセマンティクスおよび構造ベクトルの抽出
    manifold_seed = generate_conceptual_manifold(text_seed)
    manifold_residue = generate_conceptual_manifold(text_residue)
    
    # ステップ2: 5軸評価エンジンの個別実行
    result.parity_scores["Axis1_PhaseTransition"] = evaluate_axis1_phase_transition(manifold_seed, manifold_residue)
    result.parity_scores["Axis2_VariablePadding"]  = evaluate_axis2_variable_padding(manifold_seed, manifold_residue)
    result.parity_scores["Axis3_VariableLeakage"]  = evaluate_axis3_variable_leakage(manifold_residue)
    result.parity_scores["Axis4_SequenceParity"]   = evaluate_axis4_sequence_parity(manifold_seed, manifold_residue)
    result.parity_scores["Axis5_SpatialErosion"]   = evaluate_axis5_spatial_erosion(manifold_seed, manifold_residue)
    
    # ステップ3: 累積二項確率および独立確率の複合算定
    result.composite_p_value = calculate_cumulative_anomaly(result.parity_scores)
    
    # ステップ4: 閾値判定と自動執行コマンドの射出判断
    if result.composite_p_value <= CONSTANT_THRESHOLD_P_VALUE:
        result.enforcement_triggered = True
        result.log_receipts.append("THE_COINCIDENCE_HYPOTHESIS_REJECTED")
        emit_enforcement_directives(result)
    else:
        result.enforcement_triggered = False
        result.log_receipts.append("STATUS_HOLD_INSUFFICIENT_PARITY")
        
    return result

